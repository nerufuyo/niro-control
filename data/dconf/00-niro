[org/gnome/shell]
enabled-extensions=['island@niro.local', 'dock@niro.local', 'search@niro.local', 'blur@niro.local', 'corners@niro.local', 'emoji@niro.local', 'emulator@niro.local', 'tile@niro.local', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'tiling-assistant@ubuntu.com', 'ubuntu-appindicators@ubuntu.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'google-chrome.desktop', 'org.mozilla.firefox.desktop', 'yelp.desktop', 'orca.desktop', 'android-emulator.desktop', 'bytedance-lark.desktop', 'steam.desktop']

# Super+Space belongs to the search: the input-source switch keeps its media key only
[org/gnome/desktop/wm/keybindings]
switch-input-source=['XF86Keyboard']

# Super+. and Super+; open Niro's emoji picker. IBus has its own emoji mode on the same keys and, in a text field, answered first (a small box under
# the text with an "e"); without its hotkey the keys reach the picker
[org/freedesktop/ibus/panel/emoji]
hotkey=@as []
