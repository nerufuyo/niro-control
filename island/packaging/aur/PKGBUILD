# Maintainer: zickrian <espejodaniel50@gmail.com>
# Island from its release tarball, with the programs GitHub Actions built. After a release,
# `./update.sh <version>` sets the version and checksum here and in .SRCINFO.

pkgname=island-bin
pkgver=1.7.1
pkgrel=1
pkgdesc='A notch-style island for the GNOME Shell top bar: music with synced lyrics, calls, a focus timer, a calendar, a file shelf, app usage and a voice assistant'
arch=('x86_64')
url='https://github.com/zickrian/isle'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('gnome-shell>=1:46' 'dconf' 'gtk4' 'glib2' 'pango' 'gdk-pixbuf2' 'gcc-libs' 'glibc' 'bash')
optdepends=('vulkan-icd-loader: speech recognition on the graphics card, else on the processor')
provides=('island')
conflicts=('island')
options=('!strip' '!debug')
install=island-bin.install
source_x86_64=("https://github.com/zickrian/isle/releases/download/v$pkgver/island-$pkgver-$CARCH-linux.tar.gz")
sha256sums_x86_64=('1d5ece532929c3e6205578fd7a1544ca92454afc8ddb31397e23e42920ef8073')

package() {
  cd "island-$pkgver-$CARCH-linux"
  local uuid=island@niro.local

  install -Dm755 -t "$pkgdir/usr/bin" bin/island-daemon bin/island-shelf bin/island-whisper scripts/island-charge-limit
  install -Dm755 scripts/setup-voice.sh "$pkgdir/usr/bin/island-setup-voice"

  local ext="$pkgdir/usr/share/gnome-shell/extensions/$uuid"
  install -d "$ext"
  cp -r --no-preserve=ownership gnome-extension/. "$ext/"
  # The settings schema goes where the system compiles it; the extension then finds it there.
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" "$ext"/schemas/*.gschema.xml
  rm -r "$ext/schemas"
  chmod -R u=rwX,go=rX "$ext"

  local service
  for service in org.niro.island.Daemon.service org.niro.island.ShelfWindow.service island-daemon.service; do
    sed -e 's|@BINDIR@|/usr/bin|' -e 's|file://%h/.local/share/doc/island|file:///usr/share/doc/island|' \
      "data/$service" > "$srcdir/$service"
  done
  install -Dm644 -t "$pkgdir/usr/share/dbus-1/services" \
    "$srcdir/org.niro.island.Daemon.service" "$srcdir/org.niro.island.ShelfWindow.service"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$srcdir/island-daemon.service"

  install -Dm644 -t "$pkgdir/usr/share/fonts/island" data/fonts/InterVariable.ttf
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE data/fonts/Inter-LICENSE.txt
  install -Dm644 -t "$pkgdir/usr/share/doc/island" README.md CHANGELOG.md
}
