post_install() {
  echo 'Log out and back in, then turn Island on once as each user (in the Extensions app, or):'
  echo '  gnome-extensions enable island@niro.local'
  echo 'For the voice assistant, each user also runs island-setup-voice once.'
}

post_upgrade() {
  echo 'Log out and back in so GNOME Shell loads the new Island.'
}

pre_remove() {
  echo "Island's alert hooks stay in Claude Code's and Codex's settings, calling the removed island-daemon."
  echo "Each user who ran Island runs 'island-daemon --unhook-all' before removing island-bin"
  echo "(afterwards: reinstall it, run that, then remove it again)."
}
